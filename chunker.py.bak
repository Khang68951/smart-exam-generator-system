def split_text_into_chunks(text:str, chunk_size: int =1000, chunk_overlap: int=200):
    chunks= []
    start = 0 
    text_length = len(text)
    while start < text_length:
        end = start + chunk_size
        if end >= text_length:
            chunks.append(text[start:text_length].strip())
            break 

        chunk_content = text[start:end]
        last_period = chunk_content.rfind('.') 
        last_newline = chunk_content.rfind('\n')
        cut_point = max(last_period,last_newline)

        if cut_point > int(chunk_size * 0.5):
            end = start + cut_point + 1 

        actual_chunk = text[start:end].strip()
        if actual_chunk:
            chunks.append(actual_chunk)

        start = end - chunk_overlap 
    
    return chunks   
